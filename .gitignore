# Build output, in the workspace and in every fixture or spike crate.
target/
fixtures/*/Cargo.lock
crates/*/fixtures/*/Cargo.lock
# Scratch copies holding mutated sources (normally under the system temp
# directory, never in the tree; ignored at the root in case TMPDIR points
# here).
/cherenkov-fidelity-*/
/cherenkov-run-*/
.ctxloom/sessions/
__pycache__/
.claude/settings.local.json
# Development against the angzarr checkouts: the machine-local cargo [patch]
# written by `cargo local-pins`, and the link to the dev module
# (tools/dev/install.sh). .cargo/config.toml stays ignored: local-pins adds
# only an optional include of local-pins.toml to it.
/.cargo/config.toml
/.cargo/local-pins.toml
/.dev
