# Messages for the ports' errors. Each id is an error's code, which begins
# with the crate's name; the variables are its args.

cherenkov-run-ports-unknown-language = no profile for language { $lang }
cherenkov-run-ports-parser = parser failure: { $detail }
cherenkov-run-ports-incomplete = parser failure: parse did not complete
cherenkov-run-ports-no-recording = this executor does not record which tests call what
